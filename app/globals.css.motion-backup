/* THEME SWITCH FLOW START */
.theme-switch {
  --theme-option-width: 44px;
  --theme-switch-height: 36px;

  position: relative;
  display: grid;
  grid-template-columns: repeat(2, var(--theme-option-width));
  height: var(--theme-switch-height);
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: transparent;
  isolation: isolate;
  overflow: visible;
}

.theme-switch::before {
  content: "";
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;

  width: var(--theme-option-width);
  height: var(--theme-switch-height);
  border-radius: 999px;
  background: var(--switch);

  transform: translateX(0);
  transition: transform 520ms cubic-bezier(.22, 1, .36, 1);
  will-change: transform;
  pointer-events: none;
}

.theme-switch:has(.theme-option:last-child.active)::before {
  transform: translateX(var(--theme-option-width));
}

.theme-switch .theme-option,
.theme-switch:hover .theme-option,
.theme-switch:hover .theme-option + .theme-option {
  position: relative;
  z-index: 1;

  width: var(--theme-option-width);
  height: var(--theme-switch-height);
  background: transparent;
  transform: none;
  opacity: .45;

  transition: opacity 300ms ease;
}

.theme-switch .theme-option.active {
  background: transparent;
  opacity: 1;
}

.theme-switch:hover .theme-option:not(.active) {
  opacity: .7;
}

.theme-switch:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 4px;
}

@media (max-width: 560px) {
  .theme-switch {
    --theme-option-width: 38px;
    --theme-switch-height: 32px;
  }
}
/* THEME SWITCH FLOW END */

/* SHRIMP COVER WOW START */
.shrimp-cover-visual {
  --cover-scroll-rotate: 0deg;
  --cover-intro-y: 90px;
  --cover-intro-scale: .94;
  --cover-intro-rotate: -2deg;
}

.shrimp-cover-visual.reveal {
  opacity: 0;
  filter: none;
  clip-path: inset(10% 0 0 0 round 68px);
  transform: translateY(70px) scale(.97);

  transition:
    opacity 850ms cubic-bezier(.22, 1, .36, 1),
    transform 1100ms cubic-bezier(.22, 1, .36, 1),
    clip-path 1100ms cubic-bezier(.22, 1, .36, 1);
}

.shrimp-cover-visual.reveal.is-visible {
  opacity: 1;
  clip-path: inset(0 0 0 0 round 68px);
  transform: translateY(0) scale(1);

  --cover-intro-y: 0px;
  --cover-intro-scale: 1;
  --cover-intro-rotate: 0deg;
}

.shrimp-cover-visual img {
  transform:
    translate3d(
      calc(-50% + var(--cover-pointer-x)),
      calc(
        var(--cover-pointer-y) +
        var(--cover-scroll-y) +
        var(--cover-intro-y)
      ),
      0
    )
    rotate(calc(var(--cover-scroll-rotate) + var(--cover-intro-rotate)))
    scale(var(--cover-intro-scale));

  transition: transform 1000ms cubic-bezier(.22, 1, .36, 1);
  will-change: transform;
}

.shrimp-cover-visual.is-visible img {
  transition:
    transform 500ms cubic-bezier(.2, .8, .2, 1);
}

@media (max-width: 560px) {
  .shrimp-cover-visual.reveal {
    clip-path: inset(7% 0 0 0 round 38px);
  }

  .shrimp-cover-visual.reveal.is-visible {
    clip-path: inset(0 0 0 0 round 38px);
  }
}
/* SHRIMP COVER WOW END */

/* SHRIMP BLOCK PARALLAX START */
.shrimp-cover-visual {
  --cover-block-scroll-y: 0px;
  translate: 0 var(--cover-block-scroll-y);
  will-change: translate, transform;
}

@media (prefers-reduced-motion: reduce) {
  .shrimp-cover-visual {
    translate: none;
  }
}
/* SHRIMP BLOCK PARALLAX END */

/* CONTEXT CLEAN STATIC START */
.shrimp-context .shrimp-section-title {
  margin-bottom: 0;
}

.shrimp-context-grid {
  width: 100%;
  height: 760px;
  margin-top: 120px;

  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(2, minmax(0, 1fr));
