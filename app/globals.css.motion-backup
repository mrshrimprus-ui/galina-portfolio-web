  padding: 16px !important;

  transform: none !important;
  transition: none !important;
}

/* Новая плашка плавно раскрывается */
.shrimp-process-tabs button.is-active {
  width: 360px !important;
  grid-template-rows: auto 1fr !important;

  transition:
    width 420ms cubic-bezier(.16, 1, .3, 1),
    grid-template-rows 420ms cubic-bezier(.16, 1, .3, 1),
    background-color 220ms ease-out !important;
}

/* Заголовок всегда остаётся на месте */
.shrimp-process-tab-head,
.shrimp-process-tabs button.is-active .shrimp-process-tab-head {
  width: max-content !important;
  padding: 0 !important;
  margin: 0 !important;

  transform: none !important;
  transition: none !important;
  animation: none !important;
}

/* Закрытое описание не влияет на ширину плашки */
.shrimp-process-tab-copy {
  width: 0 !important;
  min-width: 0 !important;
  min-height: 0 !important;
  overflow: hidden !important;

  margin: 0 !important;
  padding: 0 !important;

  opacity: 1 !important;
  transform: none !important;
  transition: none !important;
  animation: none !important;
}

/* В открытом табе появляется область описания */
.shrimp-process-tabs button.is-active
.shrimp-process-tab-copy {
  width: 100% !important;
}

/* Сначала описание невидимо */
.shrimp-process-tab-copy-inner {
  min-height: 0 !important;
  overflow: hidden !important;

  margin: 10px 0 0 !important;
  padding: 0 !important;

  opacity: 0;
  transform: none !important;
  transition: none !important;
  animation: none !important;
}

/* После раскрытия мягко появляется только описание */
.shrimp-process-tabs button.is-active
.shrimp-process-tab-copy-inner {
  opacity: 1;

  transition:
    opacity 280ms ease-out 420ms !important;
}

/* PROCESS TABS FINAL MOTION END */
