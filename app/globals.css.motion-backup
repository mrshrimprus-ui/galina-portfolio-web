@import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap");

:root {
  --background: #09090a;
  --foreground: #ffffff;
  --secondary: rgba(255, 255, 255, 0.6);
  --switch: #333335;
  --page-padding: clamp(20px, 6.25vw, 100px);
}

:root[data-theme="light"] {
  --background: #f2f0eb;
  --foreground: #111113;
  --secondary: rgba(17, 17, 19, 0.56);
  --switch: rgba(17, 17, 19, 0.14);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--background);
}

html.lenis,
html.lenis body {
  height: auto;
}

.lenis.lenis-smooth {
  scroll-behavior: auto !important;
}

.lenis.lenis-stopped {
  overflow: clip;
}

.lenis.lenis-smooth iframe {
  pointer-events: none;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: "Manrope", Arial, sans-serif;
  font-size: 18px;
  transition: background-color 500ms cubic-bezier(.22, 1, .36, 1), color 500ms cubic-bezier(.22, 1, .36, 1);
}

.type-title,
.type-h1,
.type-h2,
.type-h3,
.type-text-l,
.type-text,
.type-text-s,
.type-caption,
.type-caption-regular,
.type-text-xs {
  font-family: inherit;
  font-style: normal;
  letter-spacing: 0 !important;
}

.type-title {
  font-weight: 500 !important;
  font-size: clamp(100px, 9vw, 190px) !important;
  line-height: 1 !important;
}

.type-h1 {
  font-weight: 600 !important;
  font-size: clamp(72px, 8.5vw, 100px) !important;
  line-height: 1.1 !important;
}

.type-h2 {
  font-weight: 500 !important;
  font-size: clamp(40px, 4.2vw, 52px) !important;
  line-height: 1.1 !important;
}

.type-h3 {
  font-weight: 600 !important;
  font-size: clamp(36px, 4.5vw, 44px) !important;
  line-height: 1.1 !important;
  letter-spacing: -.03em !important;
}

/* Make headings use the primary foreground color */
.type-title,
.type-h1,
.type-h2,
.type-h3 {
  color: var(--foreground) !important;
}

.type-text-l {
  font-weight: 500 !important;
  font-size: clamp(24px, 2.8vw, 28px) !important;
  line-height: 1.1 !important;
}

.type-text {
  font-weight: 500 !important;
  font-size: clamp(24px, 3.1vw, 29px) !important;
  line-height: 1.3 !important;
}

.type-text-s {
  font-weight: 500 !important;
  font-size: clamp(18px, 2.5vw, 20px) !important;
  line-height: 1.4 !important;
}

.type-caption {
  font-weight: 500 !important;
  font-size: clamp(16px, 2vw, 18px) !important;
  line-height: 1.4 !important;
}

.type-caption-regular {
  font-weight: 400 !important;
  font-size: clamp(16px, 2vw, 16px) !important;
  line-height: 1.4 !important;
}

.type-text-xs {
  font-weight: 500 !important;
  font-size: clamp(14px, 1.5vw, 16px) !important;
  line-height: 1.4 !important;
}

.custom-cursor-enabled,
.custom-cursor-enabled a,
.custom-cursor-enabled button,
.custom-cursor-enabled [data-cursor] {
  cursor: none !important;
}

.custom-cursor {
  position: fixed;
  z-index: 1000;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  color: #fff;
  pointer-events: none;
  opacity: 0;
  contain: layout style;
  will-change: transform;
  transition: color 300ms, opacity 180ms;
}

.custom-cursor.is-visible {
  opacity: 1;
}

.custom-cursor::before {
  content: "";
  position: absolute;
  width: 160px;
  height: 160px;
  left: -80px;
  top: -80px;
  border-radius: 50%;
  background: currentColor;
  transform: scale(.1);
  transition: transform 380ms cubic-bezier(.22, 1, .36, 1), opacity 180ms;
}

.custom-cursor[data-mode=""],
.custom-cursor[data-mode="link"],
.custom-cursor[data-mode="text"] {
  mix-blend-mode: difference;
}

.custom-cursor[data-mode="link"]::before {
  transform: scale(.26);
}

.custom-cursor[data-mode="text"]::before {
  transform: scale(.36);
}

.custom-cursor[data-mode="project"] {
  color: #fff;
  mix-blend-mode: normal;
}

.custom-cursor[data-mode="carousel-left"],
.custom-cursor[data-mode="carousel-right"] {
  color: #fff;
  mix-blend-mode: normal;
}

.custom-cursor[data-mode="carousel-left"]::before,
.custom-cursor[data-mode="carousel-right"]::before {
  transform: scale(.6);
  box-shadow: 0 8px 28px rgba(0, 0, 0, .18);
}

.custom-cursor > .case-arrow-icon {
  width: 34px;
  height: 34px;
  position: absolute;
  left: -17px;
  top: -17px;
  z-index: 2;
  display: none;
  color: #111113;
  stroke-width: 1.4;
}

.custom-cursor[data-mode="carousel-left"] > .case-arrow-icon--left,
.custom-cursor[data-mode="carousel-right"] > .case-arrow-icon--right {
  display: block;
}

.custom-cursor[data-mode^="carousel"].is-pressed::before {
  transform: scale(.53);
}

.custom-cursor[data-mode="project"]::before {
  transform: scale(1);
}

.custom-cursor.is-pressed::before {
  transform: scale(.08);
}

.custom-cursor[data-mode="link"].is-pressed::before {
  transform: scale(.21);
}

.custom-cursor[data-mode="text"].is-pressed::before {
  transform: scale(.3);
}

.custom-cursor[data-mode="project"].is-pressed::before {
  transform: scale(.86);
}

.custom-cursor[data-mode="next-project"]::before {
  opacity: 0;
}

.case-next-cursor {
  width: 260px;
  height: 260px;
  position: absolute;
  left: -130px;
  top: -130px;
  overflow: hidden;
  border-radius: 50%;
  background: #fe3638;
  opacity: 0;
  transform: scale(.18);
  box-shadow: 0 24px 70px rgba(0, 0, 0, .32);
  transition:
    opacity 220ms ease,
    transform 520ms cubic-bezier(.22, 1, .36, 1);
}

.case-next-cursor img {
  width: 142%;
  height: 142%;
  max-width: none;
  position: absolute;
  left: -21%;
  top: -14%;
  object-fit: contain;
}

.custom-cursor[data-mode="next-project"] .case-next-cursor {
  opacity: 1;
  transform: scale(1);
}

.custom-cursor[data-mode="next-project"].is-pressed .case-next-cursor {
  transform: scale(.9);
}

.custom-cursor-label {
  position: absolute;
  left: -80px;
  top: -80px;
  width: 160px;
  height: 160px;
  display: grid;
  place-items: center;
  color: #111113;
  font-size: 16px;
  font-weight: 600;
  opacity: 0;
  transform: scale(.65);
  transition: opacity 240ms, transform 380ms cubic-bezier(.22, 1, .36, 1);
}

.custom-cursor[data-mode="project"] .custom-cursor-label {
  opacity: 1;
  transform: scale(1);
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

main {
  width: min(1600px, 100%);
  min-height: 100vh;
  margin: 0 auto;
  padding: 0 var(--page-padding);
}

.site-header {
  height: 94px;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 10;
  opacity: 0;
  transform: translateY(-18px);
  animation: header-enter 900ms cubic-bezier(.22, 1, .36, 1) 120ms forwards;
}

@keyframes header-enter {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.brand {
  flex: 0 0 50%;
  width: max-content;
  font-weight: 600;
  font-size: clamp(28px, 3.7vw, 32px);
  line-height: 1.3;
}

nav {
  display: flex;
  align-items: center;
  gap: clamp(32px, 6.25vw, 100px);
}

nav a {
  position: relative;
  font-weight: 500;
  font-size: 18px;
  line-height: 1.4;
}

nav a::after,
footer a::after {
  content: "";
  position: absolute;
  inset: auto 0 -5px;
  height: 1px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 350ms cubic-bezier(.22, 1, .36, 1);
}

nav a:hover::after,
nav a:focus-visible::after,
footer a:hover::after,
footer a:focus-visible::after {
  transform: scaleX(1);
  transform-origin: left;
}

.theme-switch {
  margin-left: auto;
  padding: 0;
  border: 0;
  border-radius: 999px;
  display: flex;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.theme-switch .theme-option {
  width: 44px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  opacity: 0.55;
  transition: background-color 350ms, opacity 350ms, transform 350ms;
}

.theme-switch .theme-option.active {
  background: var(--switch);
  opacity: 1;
}

.theme-switch:hover .theme-option {
  transform: translateX(-2px);
}

.theme-switch:hover .theme-option + .theme-option {
  transform: translateX(2px);
}

.theme-icon {
  display: block;
  width: 24px;
  height: 24px;
  background: currentColor;
  opacity: 0.72;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.theme-option.active .theme-icon {
  opacity: 1;
}

.theme-icon--sun {
  -webkit-mask-image: url("/assets/sun.svg");
  mask-image: url("/assets/sun.svg");
}

.theme-icon--moon {
  -webkit-mask-image: url("/assets/moon.svg");
  mask-image: url("/assets/moon.svg");
}

.hero {
  min-height: 465px;
  padding-top: 105px;
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-content: start;
}

.hero h1 {
  grid-column: 1 / -1;
  margin: 0;
  font-weight: 500;
  font-size: clamp(100px, 10vw, 190px);
  line-height: 1;
  letter-spacing: 0;
}

.hero h1 span {
  display: block;
}

.hero-description {
  grid-column: 2;
  width: min(350px, 100%);
  margin: 6px 0 0 20px;
  font-weight: 500;
  font-size: 20px;
  line-height: 1.4;
}

.projects {
  padding-top: 78px;
  display: grid;
  gap: 24px;
}

.project-card {
  --pointer-x: 0px;
  --pointer-y: 0px;
  --scroll-lag: 0px;
  --image-scale: .94;
  height: 700px;
  position: relative;
  isolation: isolate;
  overflow: hidden;
  border-radius: 80px;
  color: #fff;
  transform: translateZ(0);
}

.project-card::before {
  content: "";
  position: absolute;
  z-index: 3;
  inset: 0;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: inherit;
  pointer-events: none;
}

.project-link {
  position: absolute;
  z-index: 6;
  inset: 0;
  border-radius: inherit;
}

.project-card--mrshrimp { background: #ff8d28; }
.project-card--punto { background: #2e2da6; }
.project-card--smarthome { background: #da2025; }

.project-copy {
  position: absolute;
  z-index: 4;
  top: 80px;
  left: 80px;
}

.project-copy h2 {
  margin: 0 0 16px;
  font-size: clamp(42px, 5.5vw, 64px);
  font-weight: 500;
  line-height: 1.1;
  letter-spacing: 0;
  opacity: 0;
  transform: translateY(36px);
  transition: opacity 850ms cubic-bezier(.22, 1, .36, 1) 180ms,
    transform 850ms cubic-bezier(.22, 1, .36, 1) 180ms;
}

.project-copy p {
  width: 376px;
  margin: 0;
  font-size: 20px;
  font-weight: 500;
  line-height: 1.4;
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 850ms cubic-bezier(.22, 1, .36, 1) 250ms,
    transform 850ms cubic-bezier(.22, 1, .36, 1) 250ms;
}

.project-meta {
  position: absolute;
  z-index: 4;
  left: 80px;
  bottom: 79px;
  width: 330px;
  margin: 0;
  line-height: 1.4;
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 850ms cubic-bezier(.22, 1, .36, 1) 330ms,
    transform 850ms cubic-bezier(.22, 1, .36, 1) 330ms;
}

.project-meta span {
  display: block;
}

.project-visual {
  position: absolute;
  z-index: 2;
  opacity: 0;
  transform: translate3d(var(--pointer-x), calc(var(--pointer-y) + var(--scroll-lag)), 0) scale(var(--image-scale));
  transition: transform 700ms cubic-bezier(.22, 1, .36, 1),
    opacity 1000ms cubic-bezier(.22, 1, .36, 1) 240ms;
  will-change: transform;
}

.project-hand,
.project-screen {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  pointer-events: none;
  user-select: none;
}

.project-card--mrshrimp .project-visual {
  width: 597px;
  height: 848px;
  left: 57.35%;
  top: 39px;
}

.project-card--mrshrimp .screen-mask {
  position: absolute;
  width: 254.7px;
  height: 540.7px;
  left: 58.5px;
  top: 12.5px;
  overflow: hidden;
  border-radius: 31px;
}

.project-card--mrshrimp .project-screen {
  width: 597px;
  height: 848px;
  left: -58.5px;
  top: -12.5px;
  max-width: none;
  object-fit: cover;
}

.project-card--punto .project-visual {
  width: 775px;
  height: 722px;
  left: 31.2%;
  top: 44px;
}

.project-card--punto .screen-mask {
  position: absolute;
  inset: 0;
}

.project-card--punto .project-screen {
  object-fit: cover;
  -webkit-mask-image: radial-gradient(ellipse 23% 35% at 75% 35%, #000 70%, transparent 72%);
  mask-image: radial-gradient(ellipse 23% 35% at 75% 35%, #000 70%, transparent 72%);
}

.project-card--smarthome .project-visual {
  width: 576px;
  height: 821px;
  left: 56%;
  top: 0;
  transform: translate3d(var(--pointer-x), calc(var(--pointer-y) + var(--scroll-lag)), 0) rotate(-10.56deg) scale(var(--image-scale));
}

.project-card--smarthome .screen-mask {
  position: absolute;
  width: 241px;
  height: 524px;
  left: 60px;
  top: 12px;
  overflow: hidden;
  border-radius: 31px;
}

.project-card--smarthome .project-screen {
  width: 576px;
  height: 821px;
  left: -60px;
  top: -12px;
  max-width: none;
  object-fit: cover;
}

.project-card:hover .project-visual {
  --image-scale: 1.025;
  transition-duration: 250ms;
}

.project-card.is-visible {
  --image-scale: 1;
}

.project-card.is-visible:hover {
  --image-scale: 1.025;
}

.project-card.is-visible .project-copy h2,
.project-card.is-visible .project-copy p,
.project-card.is-visible .project-meta {
  opacity: 1;
  transform: translateY(0);
}

.project-card.is-visible .project-visual {
  opacity: 1;
}

footer {
  height: 250px;
  padding: 80px 0 70px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  color: var(--secondary);
}

footer p {
  margin: 0;
}

footer a {
  position: relative;
}

.reveal {
  opacity: 0;
  filter: blur(6px);
  transform: translateY(58px);
  transition: opacity 1100ms cubic-bezier(.22, 1, .36, 1) var(--delay, 0ms),
    transform 1100ms cubic-bezier(.22, 1, .36, 1) var(--delay, 0ms),
    filter 900ms cubic-bezier(.22, 1, .36, 1) var(--delay, 0ms);
}

.reveal.is-visible {
  opacity: 1;
  filter: blur(0);
  transform: translateY(0);
}

.reveal-heading {
  opacity: 1;
  filter: none;
  transform: none;
  transition: none;
}

.reveal-heading span {
  clip-path: inset(0 0 100% 0);
  transform: translateY(50px);
  transition: clip-path 1050ms cubic-bezier(.22, 1, .36, 1),
    transform 1050ms cubic-bezier(.22, 1, .36, 1);
}

.reveal-heading span + span {
  transition-delay: 90ms;
}

.reveal-heading.is-visible span {
  clip-path: inset(0 0 0 0);
  transform: translateY(0);
}

.project-card.reveal {
  opacity: 0;
  filter: none;
  clip-path: inset(11% 0 0 0 round 80px);
  transform: translateY(90px) scale(.965);
  transition: opacity 1000ms cubic-bezier(.22, 1, .36, 1) var(--delay, 0ms),
    transform 1200ms cubic-bezier(.22, 1, .36, 1) var(--delay, 0ms),
    clip-path 1200ms cubic-bezier(.22, 1, .36, 1) var(--delay, 0ms);
}

.project-card.reveal.is-visible {
  opacity: 1;
  clip-path: inset(0 0 0 0 round 80px);
  transform: translateY(0) scale(1);
}

@media (max-width: 900px) {
  nav {
    display: none;
  }

  .brand {
    flex-basis: auto;
    flex-grow: 1;
  }

  .hero {
    min-height: 540px;
    padding-top: 110px;
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: clamp(58px, 14vw, 110px);
    line-height: .88;
  }

  .hero-description {
    grid-column: 1;
    align-self: end;
    margin: 44px 0 0;
  }

  .project-card {
    height: min(720px, 130vw);
    min-height: 600px;
    border-radius: 48px;
  }

  .project-card.reveal {
    clip-path: inset(9% 0 0 0 round 48px);
  }

  .project-card.reveal.is-visible {
    clip-path: inset(0 0 0 0 round 48px);
  }

  .project-copy {
    top: 46px;
    left: 42px;
  }

  .project-copy h2 {
    font-size: clamp(42px, 8vw, 44px);
  }

  .project-meta {
    left: 42px;
    bottom: 42px;
    font-size: clamp(14px, 1.5vw, 16px);
  }

  .project-card--mrshrimp .project-visual {
    left: 42%;
    top: 18%;
  }

  .project-card--punto .project-visual {
    left: 8%;
    top: 18%;
  }

  .project-card--smarthome .project-visual {
    left: 35%;
    top: 18%;
  }
}

@media (max-width: 560px) {
  body {
    font-size: 18px;
  }

  main {
    padding-inline: 16px;
  }

  .site-header {
    height: 76px;
  }

  .brand {
    font-size: clamp(28px, 3.7vw, 32px);
  }

  .theme-switch .theme-option {
    width: 38px;
    height: 32px;
  }

  .hero {
    min-height: 510px;
    padding-top: 80px;
  }

  .hero h1 {
    font-size: clamp(72px, 15vw, 84px);
  }

  .hero-description {
    width: 270px;
  }

  .projects {
    padding-top: 45px;
    gap: 12px;
  }

  .project-card {
    height: 600px;
    min-height: 0;
    border-radius: 32px;
  }

  .project-card.reveal {
    clip-path: inset(7% 0 0 0 round 32px);
  }

  .project-card.reveal.is-visible {
    clip-path: inset(0 0 0 0 round 32px);
  }

  .project-copy {
    top: 32px;
    left: 28px;
    right: 24px;
  }

  .project-copy h2 {
    font-size: clamp(42px, 8vw, 44px);
    margin-bottom: 10px;
  }

  .project-copy p {
    width: min(310px, 100%);
  }

  .project-meta {
    left: 28px;
    bottom: 30px;
    width: 280px;
    font-size: clamp(14px, 1.5vw, 16px);
  }

  .project-arrow {
    display: none;
  }

  .project-card--mrshrimp .project-visual {
    width: 480px;
    height: 680px;
    left: 20%;
    top: 22%;
  }

  .project-card--mrshrimp .screen-mask {
    width: 205px;
    height: 434px;
    left: 47px;
    top: 10px;
    border-radius: 25px;
  }

  .project-card--mrshrimp .project-screen {
    width: 480px;
    height: 680px;
    left: -47px;
    top: -10px;
  }

  .project-card--punto .project-visual {
    width: 620px;
    height: 578px;
    left: -26%;
    top: 24%;
  }

  .project-card--smarthome .project-visual {
    width: 470px;
    height: 670px;
    left: 13%;
    top: 23%;
  }

  .project-card--smarthome .screen-mask {
    width: 197px;
    height: 428px;
    left: 49px;
    top: 10px;
    border-radius: 25px;
  }

  .project-card--smarthome .project-screen {
    width: 470px;
    height: 670px;
    left: -49px;
    top: -10px;
  }

  footer {
    height: 180px;
    padding-bottom: 44px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  .reveal {
    opacity: 1;
    filter: none;
    transform: none;
  }

  .reveal-heading span,
  .project-card .project-copy h2,
  .project-card .project-copy p,
  .project-card .project-meta,
  .project-card .project-visual {
    opacity: 1;
    clip-path: none;
    transform: none;
  }

  .project-card--smarthome .project-visual {
    transform: rotate(-10.56deg);
  }
}

@media (pointer: coarse) {
  .custom-cursor {
    display: none;
  }
}

/* MrShrimp case */

.shrimp-case {
  width: 100%;
  max-width: none;
  padding: 0;
  overflow: clip;
}

/* Make most body text inside the MrShrimp case use the caption-18 visual
   (color + readable 18px size) while keeping headings' sizes intact. */
.shrimp-case {
  color: var(--foreground);
}

.shrimp-case :where(p, span, li, small, .shrimp-meta, .shrimp-result-note) {
