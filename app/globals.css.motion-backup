/* PROCESS SEQUENCE MOTION START */

/* 1. Сначала раскрывается таб */
.shrimp-process-tabs button {
  transition:
    width 380ms cubic-bezier(.22, 1, .36, 1),
    grid-template-rows 380ms cubic-bezier(.22, 1, .36, 1),
    background-color 240ms ease-out !important;
}

/* Убираем общую одновременную анимацию всей сцены */
.shrimp-process-scene {
  animation: none !important;
}

/* 2. Затем появляется изображение */
.process-visual {
  animation:
    process-image-enter 540ms cubic-bezier(.22, 1, .36, 1)
    280ms both !important;
}

/* 3. Последним появляется текст справа снизу */
.shrimp-process-result {
  animation:
    process-result-enter 520ms cubic-bezier(.22, 1, .36, 1)
    650ms both !important;
}

@keyframes process-image-enter {
  from {
    opacity: 0;
    filter: blur(7px);
  }

  to {
    opacity: 1;
    filter: blur(0);
  }
}

@keyframes process-result-enter {
  from {
    opacity: 0;
    transform: translate3d(32px, 12px, 0);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .process-visual,
  .shrimp-process-result {
    animation: none !important;
  }
}

/* PROCESS SEQUENCE MOTION END */

/* PROCESS PREMIUM MOTION START */

/* Таб раскрывается мягко, без резкого торможения */
