  transition:
    width 480ms cubic-bezier(.16, 1, .3, 1),
    grid-template-rows 480ms cubic-bezier(.16, 1, .3, 1),
    background-color 280ms ease-out !important;
}

/* Текст внутри активного таба слегка поднимается */
